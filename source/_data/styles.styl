// ========== Portal Homepage ==========

.portal-page
  .post-block
    border: none
    box-shadow: none

.portal-container
  text-align: center
  padding: 60px 20px

.portal-title
  font-size: 2.2em
  font-weight: 700
  margin-bottom: 8px
  color: #333

.portal-subtitle
  font-size: 1.1em
  color: #888
  margin-bottom: 50px

.portal-cards
  display: flex
  justify-content: center
  gap: 40px
  flex-wrap: wrap

.portal-card
  display: block
  width: 280px
  padding: 40px 30px
  border-radius: 12px
  text-decoration: none !important
  color: #333 !important
  transition: all 0.3s ease
  border: 1px solid #eee
  background: #fff

  &:hover
    transform: translateY(-6px)
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.1)
    border-color: transparent

  h2
    font-size: 1.4em
    margin: 16px 0 10px
    color: #333

  p
    font-size: 0.9em
    color: #999
    line-height: 1.6
    margin-bottom: 20px

.portal-card-icon
  font-size: 3em

.portal-card-articles .portal-card-icon
  color: #4a90d9

.portal-card-projects .portal-card-icon
  color: #e8a838

.portal-card-action
  display: inline-block
  font-size: 0.9em
  color: #4a90d9 !important
  font-weight: 600

// ========== Articles Category Cards ==========

.category-cards
  display: flex
  justify-content: center
  gap: 30px
  flex-wrap: wrap
  margin-top: 20px

.category-card
  display: block
  width: 260px
  padding: 30px 24px
  border-radius: 10px
  text-decoration: none !important
  color: #333 !important
  transition: all 0.3s ease
  border: 1px solid #eee
  background: #fff
  text-align: center

  &:hover
    transform: translateY(-4px)
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08)
    border-color: #4a90d9

  h3
    font-size: 1.2em
    margin: 12px 0 8px
    color: #333

  p
    font-size: 0.85em
    color: #999
    line-height: 1.5
    margin-bottom: 14px

.category-card-icon
  font-size: 2.4em
  color: #4a90d9

.category-card-count
  display: inline-block
  font-size: 0.8em
  color: #fff
  background: #4a90d9
  padding: 3px 12px
  border-radius: 12px

// ========== Projects Placeholder ==========

.projects-placeholder
  text-align: center
  padding: 80px 20px

  h2
    font-size: 1.6em
    color: #999
    margin: 20px 0 10px

  p
    color: #bbb
    margin-bottom: 30px

.projects-placeholder-icon
  font-size: 4em
  color: #ddd
